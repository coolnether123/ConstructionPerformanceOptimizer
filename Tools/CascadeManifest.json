{
  "schemaVersion": 1,
  "id": "construction-performance-optimizer",
  "sourceBranch": "main",
  "allowedSourceBranches": [
    "main",
    "Dev"
  ],
  "sourceVersion": "1.6",
  "supportVersions": [
    "1.5",
    "1.4",
    "1.3",
    "1.2",
    "1.1",
    "1.0"
  ],
  "payloadRoots": [
    "1.6/Assemblies",
    "1.5/Assemblies",
    "1.4/Assemblies",
    "1.3/Assemblies",
    "1.2/Assemblies",
    "1.1/Assemblies",
    "1.0/Assemblies"
  ],
  "copyBackPaths": [
    "1.5/Assemblies",
    "1.4/Assemblies",
    "1.3/Assemblies",
    "1.2/Assemblies",
    "1.1/Assemblies",
    "1.0/Assemblies"
  ],
  "build": {
    "project": "Source/ConstructionPerformanceOptimizer.csproj",
    "configurationTemplate": "RW{version}"
  },
  "hooks": [
    {
      "name": "cpo-set-branch-metadata",
      "path": "Tools/Invoke-SupportCascade.ps1",
      "phase": "after-merge",
      "versions": [
        "*"
      ]
    },
    {
      "name": "cpo-sync-branch-payload",
      "path": "Tools/Invoke-SupportCascade.ps1",
      "phase": "before-stage",
      "versions": [
        "*"
      ]
    }
  ],
  "additionalActions": [],
  "copyBack": true,
  "push": false,
  "restoreSource": true
}
