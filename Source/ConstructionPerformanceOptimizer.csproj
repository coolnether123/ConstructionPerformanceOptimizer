<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <Configurations>Debug;Release;1.6</Configurations>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <AssemblyName>Construction Performance Optimizer</AssemblyName>
    <RootNamespace>ConstructionPerformanceOptimizer</RootNamespace>
    <Version>1.0.0</Version>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <FileVersion>1.0.0.0</FileVersion>
    <InformationalVersion>1.0</InformationalVersion>
    <!-- Keep release binaries reproducible before and after a Git commit. The
         benchmark and Workshop package can therefore use the exact same DLL. -->
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <Authors>Coolnether123</Authors>
    <Description>Adaptive deterministic construction performance optimization for RimWorld 1.6.</Description>
    <Copyright>Copyright © 2026 Coolnether123</Copyright>
    <Deterministic>true</Deterministic>
    <DisableImplicitConfigurationDefines>true</DisableImplicitConfigurationDefines>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <DebugType Condition="'$(Configuration)' != 'Debug'">None</DebugType>
    <OutputPath>..\1.6\Assemblies\</OutputPath>
    <DefineConstants>TRACE</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Krafs.Rimworld.Ref" Version="1.6.4850" />
    <PackageReference Include="Lib.Harmony" Version="2.4.2" ExcludeAssets="runtime" />
    <PackageReference Include="RimWorld.MultiplayerAPI" Version="0.6.0" />
  </ItemGroup>

  <Target
    Name="RejectHistoricalApiConfiguration"
    BeforeTargets="PrepareForBuild"
    Condition="'$(Configuration)' != 'Debug' And '$(Configuration)' != 'Release' And '$(Configuration)' != '1.6'">
    <Error Text="The current source branch targets RimWorld 1.6 only. Build historical APIs from their Support/&lt;version&gt; branches." />
  </Target>
</Project>
