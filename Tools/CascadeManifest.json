{
  "schemaVersion": 1,
  "id": "construction-performance-optimizer",
  "strategy": "support-branches",
  "allowRealExecution": true,
  "sourceBranch": "main",
  "sourceVersion": "1.6",
  "supportVersions": [
    "1.5",
    "1.4",
    "1.3",
    "1.2",
    "1.1",
    "1.0"
  ],
  "payloadRoots": [
    "1.6/Assemblies",
    "1.5/Assemblies",
    "1.4/Assemblies",
    "1.3/Assemblies",
    "1.2/Assemblies",
    "1.1/Assemblies",
    "1.0/Assemblies",
    "Assemblies",
    "About/About.xml",
    "LoadFolders.xml"
  ],
  "copyBackPaths": [
    "1.5/Assemblies",
    "1.4/Assemblies",
    "1.3/Assemblies",
    "1.2/Assemblies",
    "1.1/Assemblies",
    "1.0/Assemblies"
  ],
  "stagePayloadRootsByVersion": {
    "1.5": ["1.5/Assemblies", "Assemblies", "About/About.xml", "LoadFolders.xml"],
    "1.4": ["1.4/Assemblies", "Assemblies", "About/About.xml", "LoadFolders.xml"],
    "1.3": ["1.3/Assemblies", "Assemblies", "About/About.xml", "LoadFolders.xml"],
    "1.2": ["1.2/Assemblies", "Assemblies", "About/About.xml", "LoadFolders.xml"],
    "1.1": ["1.1/Assemblies", "Assemblies", "About/About.xml", "LoadFolders.xml"],
    "1.0": ["1.0/Assemblies", "Assemblies", "About/About.xml", "LoadFolders.xml"]
  },
  "build": {
    "project": "Tools/Build-CascadeVersion.ps1",
    "configurationTemplate": "{version}",
    "expectedAssembly": "Construction Performance Optimizer.dll"
  },
  "hooks": [
    {
      "name": "cpo-set-branch-metadata",
      "path": "Tools/CascadeHooks.ps1",
      "phase": "after-merge",
      "versions": [
        "*"
      ]
    },
    {
      "name": "cpo-sync-branch-payload",
      "path": "Tools/CascadeHooks.ps1",
      "phase": "before-stage",
      "versions": [
        "*"
      ]
    }
  ],
  "additionalActions": [],
  "copyBack": true,
  "push": false,
  "restoreSource": true
}
